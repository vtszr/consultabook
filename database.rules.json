{
  "rules": {
    "consultabook": {
      "profs": {
        "$uid": { ".read": "auth != null && auth.uid === $uid" }
      },
      "slots": {
        ".read": true,
        "$slot": {
          ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid && !root.child('consultabook/profs').child(auth.uid).exists()) || (data.exists() && !newData.exists() && (data.val() === auth.uid || $slot.beginsWith(root.child('consultabook/profs').child(auth.uid).val() + '_'))))",
          ".validate": "$slot.matches(/^[0-9]+_[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{4}$/)"
        }
      },
      "blocked": {
        ".read": true,
        "$pid": {
          ".write": "auth != null && $pid === root.child('consultabook/profs').child(auth.uid).val() + ''",
          "$i": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}(\\|[0-9]{2}:[0-9]{2}-[0-9]{2}:[0-9]{2})?$/)" }
        }
      },
      "appointments": {
        ".indexOn": ["uid", "pid"],
        ".read": "auth != null && ((query.orderByChild == 'uid' && query.equalTo == auth.uid) || (query.orderByChild == 'pid' && query.equalTo == root.child('consultabook/profs').child(auth.uid).val()))",
        "$id": {
          ".read": "auth != null && (data.child('uid').val() === auth.uid || data.child('pid').val() === root.child('consultabook/profs').child(auth.uid).val())",
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && !root.child('consultabook/profs').child(auth.uid).exists() && newData.child('lock').val() === newData.child('pid').val() + '_' + newData.child('date').val() + '_' + newData.child('time').val().replace(':', '') && root.child('consultabook/slots').child(newData.child('lock').val()).val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('uid').val() === auth.uid || data.child('pid').val() === root.child('consultabook/profs').child(auth.uid).val())))",
          ".validate": "newData.hasChildren(['id', 'pid', 'uid', 'name', 'idx', 'date', 'time', 'label', 'lock', 'topic'])",
          "id":    { ".validate": "newData.isNumber()" },
          "pid":   { ".validate": "newData.isNumber()" },
          "uid":   { ".validate": "newData.isString()" },
          "name":  { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
          "idx":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
          "email": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "dept":  { ".validate": "newData.isString() && newData.val().length <= 60" },
          "year":  { ".validate": "newData.isString() && newData.val().length <= 20" },
          "topic": { ".validate": "newData.isString() && newData.val().length <= 500" },
          "date":  { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
          "time":  { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}:[0-9]{2}$/)" },
          "label": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "lock":  { ".validate": "newData.isString()" },
          "comment": {
            ".write": "auth != null && data.parent().exists() && data.parent().child('pid').val() === root.child('consultabook/profs').child(auth.uid).val()",
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
